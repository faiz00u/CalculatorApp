<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#0B1020">
    <TextView android:id="@+id/display" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2" android:gravity="bottom|end" android:padding="16dp" android:text="0" android:textColor="#FFFFFF" android:textSize="52sp" android:maxLines="1" />
    <GridLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="5" android:columnCount="4" android:rowCount="5" android:useDefaultMargins="true">
        <Button android:id="@+id/ac" android:text="AC" style="@style/CalcButton" />
        <Button android:id="@+id/back" android:text="⌫" style="@style/CalcButton" />
        <Button android:id="@+id/percent" android:text="%" style="@style/CalcButton" />
        <Button android:id="@+id/div" android:text="÷" style="@style/CalcButton" />
        <Button android:id="@+id/b7" android:text="7" style="@style/CalcButton" /><Button android:id="@+id/b8" android:text="8" style="@style/CalcButton" /><Button android:id="@+id/b9" android:text="9" style="@style/CalcButton" /><Button android:id="@+id/mul" android:text="×" style="@style/CalcButton" />
        <Button android:id="@+id/b4" android:text="4" style="@style/CalcButton" /><Button android:id="@+id/b5" android:text="5" style="@style/CalcButton" /><Button android:id="@+id/b6" android:text="6" style="@style/CalcButton" /><Button android:id="@+id/minus" android:text="−" style="@style/CalcButton" />
        <Button android:id="@+id/b1" android:text="1" style="@style/CalcButton" /><Button android:id="@+id/b2" android:text="2" style="@style/CalcButton" /><Button android:id="@+id/b3" android:text="3" style="@style/CalcButton" /><Button android:id="@+id/plus" android:text="+" style="@style/CalcButton" />
        <Button android:id="@+id/b0" android:text="0" style="@style/CalcButton" /><Button android:id="@+id/dot" android:text="." style="@style/CalcButton" /><Button android:id="@+id/equals" android:text="=" style="@style/CalcButton" />
    </GridLayout>
</LinearLayout>
